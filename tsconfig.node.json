{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // ⚠️ `vitest.config.ts` joined this list with the type-aware lint. It is the
  // same class of file as `vite.config.ts` and was simply never added, so it sat
  // in no project — typechecked by nothing, and unparseable to a linter using
  // `projectService`. Its aliases are what the shim gates read.
  "include": ["vite.config.ts", "vitest.config.ts"]
}
