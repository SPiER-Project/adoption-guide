map "http://thespierproject.org/fhir/StructureMap/CSSRSRiskLevelToSuicideRiskConcept" = "CSSRSRiskLevelToSuicideRiskConcept"

// Derives a harmonized SPiER Suicide Risk Concept Observation from a C-SSRS
// Risk Level Observation, so a consumer that does not know the C-SSRS can
// still read the patient's risk tier.
//
// The C-SSRS counterpart of ASQResultToSuicideRiskConcept, and split the same
// way. The multi-item inference (items 1-6 -> none / low / moderate / high) is
// computed by SPiER's tested runtime mapper and persisted as a C-SSRS Risk
// Level Observation; this map does the declarative resource shaping and the
// ConceptMap translate() of that risk level to the instrument-agnostic tier,
// with provenance carried in derivedFrom.
//
// The tier assignments this map translates through are illustrative reference
// logic pending sign-off by suicide-prevention subject-matter experts.
// Adopters SHALL validate them against their own clinical protocols before
// using the harmonized tier to drive care decisions.

uses "http://hl7.org/fhir/StructureDefinition/Observation" alias CSSRSRiskLevel as source
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Concept as target

// ─── Implementation notes (not published — see README.md) ────────────
//
// Runtime counterpart: web/src/lib/observationMappers/cssrs.ts.
// Crosswalk under clinical review: ig/input/fsh/crosswalk-cssrs.fsh (#77/#93).
//
// No `imports` for the ConceptMap — see ASQResultToSuicideRiskConcept.fml.
// `StructureMap.import` is canonical(StructureMap); `translate()` resolves the
// ConceptMap from its own argument.

group cssrsRiskLevelToConcept(source src : CSSRSRiskLevel, target tgt : Concept) {
  // --- fixed / carried-through shape ---
  src -> tgt.status = 'final' "set-status";
  src.code as code -> tgt.code = code "carry-code";            // generic LOINC 93374-7 passes through unchanged
  src.subject as subj -> tgt.subject = subj "carry-subject";
  src.effective as eff -> tgt.effective = eff "carry-effective";

  // --- provenance: the concept is DERIVED from the risk-level Observation ---
  src -> tgt.derivedFrom = reference(src) "derived-from";

  // --- domain + survey category (Gravity cross-instrument filtering pattern) ---
  src -> tgt.category = cc('http://terminology.hl7.org/CodeSystem/observation-category', 'survey') "cat-survey";
  src -> tgt.category = cc('http://thespierproject.org/fhir/CodeSystem/spier-concept-domain', 'suicide-risk') "cat-domain";

  // --- value: translate the C-SSRS risk-level coding to the common tier coding ---
  src.value : CodeableConcept as level -> tgt.value = create('CodeableConcept') as tier then {
    level.coding as lc -> tier.coding = translate(lc, 'http://thespierproject.org/fhir/ConceptMap/CSSRSRiskLevelToRiskTier', 'Coding') "translate-tier";
  } "map-value";

  // --- interpretation: NEG for a 'none' risk level, POS otherwise ---
  src.value : CodeableConcept as level where (coding.code = 'none') ->
    tgt.interpretation = cc('http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation', 'NEG') "interp-neg";
  src.value : CodeableConcept as level where (coding.code != 'none') ->
    tgt.interpretation = cc('http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation', 'POS') "interp-pos";
}
