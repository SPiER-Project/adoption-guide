map "http://spier.org/StructureMap/ASQResultToSuicideRiskConcept" = "ASQResultToSuicideRiskConcept"

// Derives a harmonized SPiER Suicide Risk Concept Observation from an ASQ
// Result Observation, so a consumer that does not know the ASQ can still read
// the patient's risk tier.
//
// Turning an ASQ into a tier is two steps, deliberately split. Inferring the
// disposition (negative / non-acute-positive / acute-positive) from items
// Q1-Q4 OR-gated by Q5 is multi-item boolean logic; it is computed by SPiER's
// tested runtime mapper and persisted as an ASQ Result Observation
// (LOINC 93374-7, value = disposition). This map does the second step:
// declarative resource shaping plus a ConceptMap translate() of that
// disposition to the instrument-agnostic tier, with provenance carried in
// derivedFrom. Re-encoding the boolean inference here would duplicate tested
// runtime logic in a language with no test harness; a QuestionnaireResponse
// -> concept variant could fold it in if a fully FHIR-native extraction is
// ever required.
//
// The tier assignments this map translates through are illustrative reference
// logic pending sign-off by suicide-prevention subject-matter experts.
// Adopters SHALL validate them against their own clinical protocols before
// using the harmonized tier to drive care decisions.

uses "http://hl7.org/fhir/StructureDefinition/Observation" alias ASQResult as source
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Concept as target

// ─── Implementation notes (not published — see README.md) ────────────
//
// Everything above the `uses` lines becomes StructureMap.description in the
// built IG, so repo mechanics belong here rather than there.
//
// Runtime counterpart: web/src/lib/observationMappers/asq.ts.
// Crosswalk under clinical review: ig/input/fsh/crosswalk-asq.fsh (#77 / #93).
// Design background: docs/best-practices/concept-harmonization.md.
//
// There is deliberately no `imports` for the ConceptMap. `StructureMap.import`
// is canonical(StructureMap); pointing it at a ConceptMap is a conformance
// error ("refers to a resource that has the wrong type") that the IG Publisher
// catches and `validator_cli … compile` does not. `translate()` resolves the
// ConceptMap from its own second argument, so the import bought nothing.

group asqResultToConcept(source src : ASQResult, target tgt : Concept) {
  // --- fixed / carried-through shape ---
  src -> tgt.status = 'final' "set-status";
  src.code as code -> tgt.code = code "carry-code";            // generic LOINC 93374-7 passes through unchanged
  src.subject as subj -> tgt.subject = subj "carry-subject";
  src.effective as eff -> tgt.effective = eff "carry-effective";

  // --- provenance: the concept is DERIVED from the disposition Observation ---
  src -> tgt.derivedFrom = reference(src) "derived-from";

  // --- domain + survey category (Gravity cross-instrument filtering pattern) ---
  src -> tgt.category = cc('http://terminology.hl7.org/CodeSystem/observation-category', 'survey') "cat-survey";
  src -> tgt.category = cc('http://spier.org/CodeSystem/spier-concept-domain', 'suicide-risk') "cat-domain";

  // --- value: translate the ASQ disposition coding to the common tier coding ---
  src.value : CodeableConcept as disp -> tgt.value = create('CodeableConcept') as tier then {
    disp.coding as dc -> tier.coding = translate(dc, 'http://spier.org/ConceptMap/ASQDispositionToRiskTier', 'Coding') "translate-tier";
  } "map-value";

  // --- interpretation: NEG for a negative disposition, POS otherwise ---
  src.value : CodeableConcept as disp where (coding.code = 'negative') ->
    tgt.interpretation = cc('http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation', 'NEG') "interp-neg";
  src.value : CodeableConcept as disp where (coding.code != 'negative') ->
    tgt.interpretation = cc('http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation', 'POS') "interp-pos";
}
