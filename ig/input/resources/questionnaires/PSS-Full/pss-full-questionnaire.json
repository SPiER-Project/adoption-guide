        { "valueCoding": { "system": "http://thespierproject.org/fhir/CodeSystem/pss3-answer", "code": "unable-to-complete", "display": "Patient unable to complete" } },
        { "valueCoding": { "system": "http://thespierproject.org/fhir/CodeSystem/pss3-answer", "code": "patient-refused", "display": "Patient refused" } }
      ]
    },
