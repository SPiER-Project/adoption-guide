{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "composite": true,
    "types": ["vite/client"],
    "paths": {
      // ⚠️ **No `fhirclient` entry, deliberately — see vite.config.ts.**
      // fhirclient 3 is exports-only: `fhirclient/Client` and
      // `fhirclient/browser` are export-map names, not paths on disk, so a
      // `fhirclient/*` mapping resolves nothing. `moduleResolution: "bundler"`
      // reads that export map from the root install.
      "@spier/core/*": ["../../packages/core/src/*"],
      "@spier/ui/*": ["../../packages/ui/src/*"],
      "@spier/tool-views/*": ["../../packages/tool-views/src/*"],
      "@spier/app-shell/*": ["../../packages/app-shell/src/*"],
      "@spier/fhir-artifacts/*": ["../../packages/fhir-artifacts/*"],
      "@spier/demo-population": ["../../packages/demo-population/src/index.ts"],
      "@spier/demo-population/*": ["../../packages/demo-population/src/*"]
    }
  },
  // ⚠️ The packages' sources are INCLUDED, not referenced — the arrangement
  // every package here already uses. A `composite` project's program may not
  // contain a file its own `include` does not name (TS6307), and these are
  // reached through the `@spier/*` path mappings above, so a reference without
  // declaration output (everything here is `noEmit`) leaves tsc compiling their
  // sources anyway and then objecting that they are not listed.
  "include": [
    "src",
    "../../packages/core/src",
    "../../packages/ui/src",
    "../../packages/tool-views/src",
    "../../packages/app-shell/src",
    "../../packages/demo-population/src/**/*.ts",
    "../../packages/fhir-artifacts/generated/**/*.ts"
  ],
  // ⚠️ Their TESTS stay out: type-checking a package's suite here would be a
  // second opinion on files that package's own project already checks.
  "exclude": [
    "../../packages/core/src/**/*.test.ts",
    "../../packages/core/src/**/*.test.tsx",
    "../../packages/ui/src/**/*.test.tsx",
    "../../packages/tool-views/src/**/*.test.ts",
    "../../packages/tool-views/src/**/*.test.tsx",
    "../../packages/app-shell/src/**/*.test.ts",
    "../../packages/app-shell/src/**/*.test.tsx"
  ]
}
