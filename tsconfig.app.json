{
  // The root's own project: the cross-package tests under tests/ and the two
  // dependency shims. The apps and packages each have their own config.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // `node` because several of these tests read fixtures off disk (`node:fs`,
    // `__dirname`), and nothing else in this project brings those globals in.
    "types": ["vite/client", "node"],
    "paths": {
      // ⚠️ **No `fhirclient` entry, deliberately — see vite.config.ts.**
      "@spier/core/*": ["./packages/core/src/*"],
      "@spier/ui/*": ["./packages/ui/src/*"],
      "@spier/tool-views/*": ["./packages/tool-views/src/*"],
      "@spier/app-shell/*": ["./packages/app-shell/src/*"],
      "@spier/fhir-artifacts/*": ["./packages/fhir-artifacts/*"],
      "@spier/demo-population": ["./packages/demo-population/src/index.ts"],
      "@spier/demo-population/*": ["./packages/demo-population/src/*"]
    }
  },
  "include": ["tests", "shims"]
}
