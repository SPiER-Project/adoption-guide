{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "composite": true,
    // ⚠️ No DOM, unlike the base: this package is the React-free, DOM-free
    // domain layer, and leaving `lib.dom` out is what makes `document` a
    // compile error here.
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      // The colocated tests import their own subject through the same
      // `@spier/core/<path>` alias the apps use, so this project resolves its
      // own alias too.
      "@spier/core/*": ["./src/*"],
      "@spier/fhir-artifacts/*": ["../fhir-artifacts/*"],
      "@spier/demo-population": ["../demo-population/src/index.ts"],
      "@spier/demo-population/*": ["../demo-population/src/*"]
    }
  },
  "include": [
    "src",
    "../fhir-artifacts/generated/**/*.ts",
    "../demo-population/src/**/*.ts"
  ]
}
