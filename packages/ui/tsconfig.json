{
  // ⚠️ This file must exist even though it adds almost nothing: esbuild finds a
  // tsconfig by walking up from the file it is transforming, and this is the
  // one it finds for packages/ui/src. See `jsx` in tsconfig.base.json.
  //
  // No `paths`: the design system imports no `@spier/*` package, and the
  // absence of a mapping is what keeps it that way.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "composite": true,
    "types": ["node"]
  },
  "include": ["src"]
}
