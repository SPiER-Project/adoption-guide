{
  // SPiER on Cloudflare Workers — the Adoption Guide SPA and the rendered HL7
  // IG, both served from ./web-dist via Static Assets.
  //
  // ⚠️ The CDS Hooks API is NOT here any more (2026-09-20): it is its own
  // Worker, `spier-cds` (services/cds), because the IG, the Guide and the
  // clinical demo are three offerings and the CDS service is a fourth thing
  // SPiER publishes. The Worker NAME stays `spier-adoption-guide` so the live
  // URL does not move.
  //
  // `main` is the Vite-bundled worker (dist/index.js) — Vite is required because
  // the imported catalog/scenario loaders use import.meta.glob. `web-dist` is a
  // copy of the web app's `vite build` output (base `/`), staged by the build
  // script so the deploy artifact is self-contained — plus the rendered HL7 IG
  // under web-dist/ig, which only CI produces (deploy.yml's `cloudflare` job).
  //
  // ⚠️ Static Assets caps FILE COUNT (20,000 free / 100,000 paid) and PER-FILE
  // size (25 MiB), not total bytes. deploy.yml asserts BOTH on every deploy, and
  // the second one is why: the first attempt (#533) measured the largest file
  // INSIDE ig/output/full-ig.zip (8.88 MB) and missed that full-ig.zip is itself
  // a file in that directory, at 36.8 MiB. The deploy failed on it. Anything
  // over the cap is dropped from the copy and falls back to Pages.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spier-adoption-guide",
  "main": "./dist/index.js",
  "compatibility_date": "2025-07-01",
  "assets": {
    "directory": "./web-dist",
    "binding": "ASSETS",
    // Worker runs first for every request; it routes /cds-services itself and
    // delegates everything else to ASSETS (SPA fallback below). Unambiguous, and
    // asset-serving cost is negligible for this app.
    //
    // ⚠️ /ig is NOT a Worker route — the rendered IG is staged into ./web-dist/ig
    // by deploy.yml and served from here like any other asset. Registering a
    // Hono route for it would shadow ~4,000 real files; app.test.ts asserts it
    // stays unrouted.
    "run_worker_first": true,
    // "none" rather than "single-page-application", which every other SPA uses.
    // The app is a HashRouter: every in-app route is served from `/` with the
    // route after the `#`, so SPA fallback never carried a real navigation here.
    // What it DID do was answer a missing /ig/ path with index.html and a 200 —
    // so a dead download link returned HTML that a browser saved as a .zip. The
    // catch-all in src/index.ts now replicates the fallback explicitly for
    // non-IG paths, and sends a missing /ig/ path to the Pages copy.
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Space-separated `frame-ancestors` sources for the SPA — who may embed
    // this app in a frame. The embedded SMART panel is launched inside the mock
    // EHR on a different origin, so that origin has to be admitted. Blank =
    // DEFAULT_FRAME_ANCESTORS in packages/worker-http/src/spaAssets.ts, which
    // is 'self' plus the mock EHR's origin from deploy-origins.json (repo root).
    // A non-blank override may name only origins in that file — `npm run
    // check:origins` fails any other host. See
    // docs/plans/embedded-panel-smart-launch.md §6.
    "PANEL_FRAME_ANCESTORS": ""

    // ⚠️ The CDS_JWT_* vars left with the API on 2026-09-20 — they are in
    // services/cds/wrangler.jsonc now. CDS_JWT_AUDIENCE in particular was
    // pinned to THIS Worker's URL while the endpoint lived here; it is the
    // CDS Worker's own URL now, which is what an audience should be.
  }
}
