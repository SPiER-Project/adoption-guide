{
  // Every compiler option is in packages/worker-tooling/tsconfig.worker.json,
  // shared by the four service Workers; this file says only which files are in
  // the project. scripts/check-service-toolchain.mjs fails a service that grows
  // a compilerOptions block of its own — that is how the four copies drifted.
  "extends": "../../packages/worker-tooling/tsconfig.worker.json",
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
