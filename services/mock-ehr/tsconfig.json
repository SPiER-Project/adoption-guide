{
  // Every compiler option is in packages/worker-tooling/tsconfig.worker.json,
  // shared by the four service Workers; this file says only which files are in
  // the project. scripts/check-service-toolchain.mjs fails a service that grows
  // a compilerOptions block of its own — that is how the four copies drifted.
  "extends": "../../packages/worker-tooling/tsconfig.worker.json",
  "include": ["src", "vite.config.ts", "vite.client.config.ts", "vitest.config.ts"],
  // src/client is the BROWSER project (src/client/tsconfig.json): workerd has
  // no `document`, so the two cannot share a `lib`. `npm run typecheck` runs
  // both. The Worker reaches the built output through `import.meta.glob`
  // (clientAssets.ts) and the shared types through type-only imports of
  // src/client/types.ts, which compiles under either lib.
  "exclude": ["src/client"]
}
