{
  // The browser project. The Worker's tsconfig (../../tsconfig.json) EXCLUDES
  // this directory: workerd has no `document`, so the two cannot share a `lib`.
  // Deliberately not extending packages/worker-tooling/tsconfig.worker.json —
  // that base is the Worker toolchain, and this is the one place in services/
  // that is not a Worker. `npm run typecheck` runs both projects.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["*.ts"]
}
