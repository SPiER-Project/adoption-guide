# OS metadata
.DS_Store
Thumbs.db

# Editor scratch / swap files
*.swp
*.swo
*~
.idea/
.vscode/

# Node / build artifacts that shouldn't be in source control
node_modules/

# FHIR resources copied from ig/fsh-generated/ at build time
# (source of truth is ig/input/fsh/; regenerated by scripts/copy-fhir.mjs)
packages/fhir-artifacts/generated/

# Vite output. Both names are the tooling host's own, at the repo root since the
# hoist: `dist` is the guide build, `dist-clinical` the VITE_SURFACE=clinical
# one. Each Worker's `stage:assets` copies the matching tree into its web-dist/.
dist/
dist-clinical/
*.local

# Resources emitted by the production builders for the #302 validator gate
# (npm run emit:runtime-fhir). Disposable; regenerated on demand.
.runtime-fhir/

# npm / tooling logs
*.log
npm-debug.log*


# Cached HL7 validator_cli jar (~190MB), downloaded on demand by
# scripts/validate-fhir.mjs
.fhir-validator/

# Local environment secrets
.env
.env.local
.env.*.local
