# `engines` in package.json is only advisory without this — npm otherwise
# installs happily on a Node version jsdom itself refuses to run under (see
# the root package.json "//engines" comment). D12,
# docs/plans/archive/repo-cruft-audit-2026-09-20.md: closes local Node drift that
# .github/.nvmrc only pins for CI.
engine-strict=true
